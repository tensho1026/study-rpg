generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  equipments    Equipment[]
  sessions      Session[]
  studyRecord   StudyRecord[]
  userStatus    UserStatus?
  battleStatus  BattleStatus[]
  dropItem      UserHasDropItems[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserStatus {
  id         String   @id @default(cuid())
  userId     String   @unique
  level      Int      @default(1)
  exp        Int      @default(0)
  money      Int      @default(0)
  totalStudy Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model StudyRecord {
  id        String    @id @default(cuid())
  userId    String
  Date      DateTime?
  minutes   Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, Date])
}

model MstEquipment {
  id          String         @id
  name        String
  price       Int
  attack      Int?
  defense     Int?
  description String
  type        EquipmentType
  equiument   Equipment[]
}

model MstEnemies {
  id        String   @id 
  dropItemId String? @unique
  name      String
  hp        Int
  maxHp     Int
  attack    Int
  defense   Int
  exp       Int
  gold      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dropItem MstMonsterDropItem?  @relation(fields: [dropItemId], references: [id])

}

model MstMonsterDropItem {
  id        String   @id 
  name      String
  rare      Int
  description String

  enemy MstEnemies?
  userHas UserHasDropItems[]
}

model MstNomalDropitem {
  id        String   @id 
  name      String
  rare      Int
  description String
  userHas UserHasDropItems[]

}

model Equipment {
  id           String       @id @default(cuid())
  equipmentId  String
  userId       String
  isDraft      Boolean
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  mstEquipment MstEquipment @relation(fields: [equipmentId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  @@unique([userId, equipmentId], name: "userId_equipmentId")
}

enum EquipmentType {
  weapon
  armor
  accessory
}


model BattleStatus {
  id           String  @id @default(cuid())
  userId       String
  maxHp        Int @default(100)
  hp           Int @default(100)
  attack Int @default(1)
  defense Int @default(1)
  level Int @default(1)
  exp Int @default(0)
  battleCoin Int @default(0)


  user         User     @relation(fields: [userId], references: [id])
} 

model UserHasDropItems {
  id String @id @default(cuid())
  userId String 
  nomalItemId String? 
  monsterItemId String? 
  quantity Int      @default(1)
  obtainedAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  monster   MstMonsterDropItem?    @relation(fields: [monsterItemId], references: [id])
  nomal   MstNomalDropitem?     @relation(fields: [nomalItemId], references: [id])
  
  @@unique([userId,nomalItemId])
  @@unique([userId,monsterItemId])
    
}


